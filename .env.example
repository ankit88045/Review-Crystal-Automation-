# ==========================================
# Crystal Makeover Salon & Academy Environment Configuration
# ==========================================

# 1. AI API KEYS (At least one recommended for custom AI responses)
# OpenRouter API (Recommended for natural Hinglish / Indian salon replies)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini API Key (Alternative)
GEMINI_API_KEY=

# 2. APPLICATION URL (For Vercel or Custom Domain)
APP_URL=https://review.crystalmakeover.com

# 3. ADMIN AUTHENTICATION
# Authorized Google Account Email allowed to access Owner Monitor and AI settings
VITE_ADMIN_EMAIL=crystalmakeoversalon@gmail.com
ADMIN_EMAIL=crystalmakeoversalon@gmail.com

# 4. GOOGLE BUSINESS PROFILE & OAUTH
# Google OAuth 2.0 Client ID for Owner Sign-In
VITE_GOOGLE_CLIENT_ID=

# Direct Google Review Link for Customers
VITE_GBP_REVIEW_LINK=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
